<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程：自动获得 Java17、Spring Boot、Spring AI Alibaba BOM 等所有版本管理 -->
    <parent>
        <groupId>com.example.springaialibaba</groupId>
        <artifactId>spring-ai-alibaba-learning</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 本模块的标识 -->
    <artifactId>19-graph-basic</artifactId>
    <name>19-Graph基础</name>
    <description>Spring AI Alibaba Graph 入门：用 StateGraph 编排一个“翻译→加工”的最小工作流</description>

    <dependencies>
        <!-- ★ DashScope Starter：自动配置 ChatClient.Builder，用于在图的节点里调用通义千问 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>

        <!-- ★ Graph 核心：阿里特色的“多智能体/工作流编排”引擎。
             提供 StateGraph（图）、OverAllState（全局状态）、NodeAction（节点）、
             KeyStrategy（状态合并策略）、CompiledGraph（编译后可执行的图）等核心类。
             版本由父工程的 spring-ai-alibaba-bom 统一管理，无需写 version。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包/运行插件：让 mvn spring-boot:run 可用 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
