<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程：自动获得 Java17、Spring Boot、Spring AI Alibaba BOM 等所有版本管理 -->
    <parent>
        <groupId>com.example.springaialibaba</groupId>
        <artifactId>spring-ai-alibaba-learning</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 本模块的标识 -->
    <artifactId>16-observability</artifactId>
    <name>16-可观测性</name>
    <description>可观测性：用 SimpleLoggerAdvisor 观察请求响应；Actuator + Micrometer 采集指标；对接 ARMS/Langfuse</description>

    <dependencies>
        <!-- ★ Spring AI Alibaba 的 DashScope Starter ★
             自动配置 DashScopeChatModel 和 ChatClient.Builder，并读取 spring.ai.dashscope.* 配置。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>

        <!-- ★ Spring Boot Actuator ★
             生产级监控端点。引入后应用会内置 /actuator/* 端点，暴露健康检查、指标(metrics)等。
             更关键的是：它带来 Micrometer 的 ObservationRegistry，
             Spring AI 的 ChatClient/ChatModel 调用会借此自动产生 observation（可转成 metrics/traces）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包/运行插件：让 mvn spring-boot:run 可用 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
