<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程：自动获得 Java17、Spring Boot、Spring AI Alibaba BOM 等所有版本管理 -->
    <parent>
        <groupId>com.example.springaialibaba</groupId>
        <artifactId>spring-ai-alibaba-learning</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 本模块的标识 -->
    <artifactId>02-chat-model</artifactId>
    <name>02-对话模型</name>
    <description>ChatModel 底层 vs ChatClient 高级客户端；流式/非流式；DashScopeChatOptions 运行时覆盖参数</description>

    <dependencies>
        <!-- ★ Spring AI Alibaba 的 DashScope Starter ★
             自动配置 DashScopeChatModel（底层模型）和 ChatClient.Builder（高级客户端），
             并读取 spring.ai.dashscope.* 配置。版本由父工程 BOM 统一管理，无需写 <version>。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包/运行插件：让 mvn spring-boot:run 可用 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
