<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程：自动获得 Java17、Spring Boot、Spring AI Alibaba BOM 等所有版本管理 -->
    <parent>
        <groupId>com.example.springaialibaba</groupId>
        <artifactId>spring-ai-alibaba-learning</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 本模块的标识 -->
    <artifactId>24-nacos-prompt</artifactId>
    <name>24-Nacos动态Prompt</name>
    <description>Spring AI Alibaba Nacos 动态 Prompt：把提示词放配置中心，改配置不重启即可更新</description>

    <dependencies>
        <!-- ★ DashScope Starter：提供 ChatClient -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>

        <!-- ★ Nacos 动态 Prompt starter：
             把 Prompt 模板托管到 Nacos 配置中心，运行时监听变更，
             改配置无需重启应用即可让提示词生效。引入它即接入这套能力。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-nacos-prompt</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
