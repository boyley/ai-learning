<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程：自动获得 Java17、Spring Boot、Spring AI / Spring AI Alibaba BOM 等所有版本管理 -->
    <parent>
        <groupId>com.example.springaialibaba</groupId>
        <artifactId>spring-ai-alibaba-learning</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 本模块的标识 -->
    <artifactId>12-document-etl</artifactId>
    <name>12-文档 ETL 管道</name>
    <description>读取文档(Extract)→切分(Transform)→写入向量库(Load)，把文件变成可检索知识</description>

    <dependencies>
        <!-- ★ DashScope Starter：提供 EmbeddingModel（向量化）。
             TextReader、TokenTextSplitter、SimpleVectorStore 等 ETL 相关类来自 Spring AI 核心，随 starter 传递引入。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
