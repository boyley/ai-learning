<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承父工程：自动获得 Java17、Spring Boot、Spring AI Alibaba BOM 等所有版本管理 -->
    <parent>
        <groupId>com.example.springaialibaba</groupId>
        <artifactId>spring-ai-alibaba-learning</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- 本模块的标识 -->
    <artifactId>01-quickstart</artifactId>
    <name>01-快速上手</name>
    <description>Spring AI Alibaba 核心概念 + 你的第一个 DashScope ChatClient 调用</description>

    <dependencies>
        <!-- ★ Spring AI Alibaba 的 DashScope Starter ★
             这是本项目最核心的依赖。它会：
             1. 自动配置好 DashScopeChatModel（底层模型）和 ChatClient.Builder（高级客户端）
             2. 自动读取 spring.ai.dashscope.* 配置（我们的共享配置文件里就是这些）
             引入它，就等于把“通义千问/百炼”的对话能力接入了 Spring。
             注意：版本号不用写，父工程的 spring-ai-alibaba-bom 已统一管理。 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 打包/运行插件：让 mvn spring-boot:run 可用 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
